---
import siteConfig from '../data/site-config';

const { isHome = false } = Astro.props;
const Name = isHome ? 'h1' : 'div';
---

<header class="w-full max-w-3xl mx-auto mb-12 sm:mb-6">
    <div class="flex items-center gap-4">
        {
            siteConfig.portrait && (
                <img 
                    src={siteConfig.portrait.src} 
                    alt={siteConfig.portrait.alt || ''} 
                    width="64"
                    height="64"
                    class="w-16 h-16 rounded-full object-cover"
                />
            )
        }
        <div>
            <Name class="m-0 text-base font-normal leading-tight">
                <a class="font-serif text-2xl leading-tight font-medium text-theme-foreground sm:text-4xl" href="/">
                    {siteConfig.title}
                </a>
            </Name>
            {siteConfig.subtitle && <p class="text-sm leading-tight mt-1">{siteConfig.subtitle}</p>}
        </div>
    </div>
</header>
