<section data-listening-preview class="hidden border-y border-dashed border-main/35 py-5 sm:py-7" aria-label="Currently listening">
  <a href="/listening/" class="group flex items-center gap-4 sm:gap-6">
    <span class="block h-16 w-16 shrink-0 border border-main/15 bg-muted p-px shadow-[2px_2px_0_rgb(var(--color-text-main)/0.08)] sm:h-20 sm:w-20" aria-hidden="true">
      <span class="relative grid h-full w-full place-items-center overflow-hidden bg-main/5">
        <span class="music-record music-record--small"><span></span></span>
        <img data-preview-image class="absolute inset-0 hidden h-full w-full object-cover" alt="" />
      </span>
    </span>
    <span class="min-w-0 flex-1">
      <span data-preview-label class="block text-[0.65rem] font-medium uppercase tracking-[0.16em] text-main/50">On the stereo</span>
      <span data-preview-title class="mt-1 block truncate font-serif text-xl leading-tight sm:text-2xl"></span>
      <span data-preview-artist class="mt-0.5 block truncate text-sm text-main/60"></span>
    </span>
    <span class="hidden shrink-0 font-serif text-sm italic underline decoration-dashed underline-offset-4 group-hover:decoration-solid sm:block">Listening ↗</span>
  </a>
</section>

<script>
  import type { MusicResponse } from '../data/music-types';
  let timer: number | undefined;

  function initListeningPreview() {
    const preview = document.querySelector<HTMLElement>('[data-listening-preview]');
    if (!preview || preview.dataset.initialized) return;
    preview.dataset.initialized = 'true';

    async function load() {
      try {
        const response = await fetch('/api/music/?period=1month');
        if (!response.ok) return;
        const data = await response.json() as MusicResponse;
        const track = data.recentTracks[0];
        if (!track || !preview.isConnected) return;
        preview.querySelector('[data-preview-label]')!.textContent = track.nowPlaying ? 'Playing now' : 'Last played';
        preview.querySelector('[data-preview-title]')!.textContent = track.title;
        preview.querySelector('[data-preview-artist]')!.textContent = track.artist;
        const image = preview.querySelector<HTMLImageElement>('[data-preview-image]')!;
        image.onerror = () => image.classList.add('hidden');
        if (track.image) {
          image.src = track.image;
          image.classList.remove('hidden');
        } else {
          image.removeAttribute('src');
          image.classList.add('hidden');
        }
        preview.classList.remove('hidden');
      } catch {
        // unavailable
      }
    }

    load();
    timer = window.setInterval(load, 60_000);
  }

  document.addEventListener('astro:before-swap', () => {
    if (timer) window.clearInterval(timer);
    timer = undefined;
  });
  document.addEventListener('astro:page-load', initListeningPreview);
  initListeningPreview();
</script>
