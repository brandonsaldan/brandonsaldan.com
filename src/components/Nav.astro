---
import siteConfig from '../data/site-config';
import { getCollection } from 'astro:content';

type Props = { railOnly?: boolean };
const { railOnly = false } = Astro.props;
const panelId = railOnly ? 'site-index-panel-rail' : 'site-index-panel';

const [projects, research, blog] = await Promise.all([
    getCollection('projects'),
    getCollection('research'),
    getCollection('blog'),
]);
const sortByDateDesc = <T extends { data: { publishDate: Date } }>(a: T, b: T) =>
    b.data.publishDate.getTime() - a.data.publishDate.getTime();
const folderEntries = {
    '/projects': projects.sort(sortByDateDesc).map((entry) => ({
        text: entry.data.title.split(': ')[0],
        href: `/projects/${entry.id}/`,
    })),
    '/research': research.sort(sortByDateDesc).map((entry) => ({
        text: entry.data.navTitle ?? entry.data.shortTitle,
        href: `/research/${entry.id}/`,
    })),
    '/blog': blog.sort(sortByDateDesc).map((entry) => ({
        text: entry.data.title,
        href: `/blog/${entry.id}/`,
    })),
};

const navLinks = siteConfig.headerNavLinks || [];
const groups = [
    { label: 'About', links: [...navLinks.filter((link) => !link.section), ...(siteConfig.footerNavLinks || [])] },
    { label: 'Work', links: navLinks.filter((link) => link.section === 'work') },
    { label: 'Personal', links: navLinks.filter((link) => link.section === 'personal') },
].filter((group) => group.links.length > 0);
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
const isCurrent = (href: string) => currentPath === normalizePath(href);
const isInSection = (href: string) => {
    const sectionPath = normalizePath(href);
    return sectionPath !== '/' && currentPath.startsWith(`${sectionPath}/`);
};
---

<nav class:list={['site-index relative pb-12 pt-4 sm:pb-8 md:pt-8 xl:pb-0 xl:pt-0', { 'rail-only': railOnly }]} aria-label="Contents">
    <div class="h-8 xl:hidden">
        <button
            type="button"
            class="index-trigger relative z-30 -ml-1 flex h-8 w-8 items-center justify-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-main xl:hidden"
            aria-expanded="false"
            aria-controls={panelId}
            aria-label="Open contents"
        >
            <span class="index-menu-icon relative h-px w-6 bg-current" aria-hidden="true"></span>
        </button>
    </div>

    <button type="button" class="index-backdrop" aria-label="Close contents" tabindex="-1"></button>

    <div id={panelId} class="index-panel">
        <div class="index-heading">
            <a href="/" class="index-eyebrow">brandonsaldan.com</a>
            <button type="button" class="index-close" aria-label="Close contents">Close <span aria-hidden="true">×</span></button>
        </div>
        {groups.map((group) => (
            <div class="index-group">
                {group.label && <p class="index-group-label">{group.label}</p>}
                <ul>
                    {group.links.map((link) => {
                        const children = folderEntries[link.href as keyof typeof folderEntries];
                        const sectionCurrent = isCurrent(link.href) || isInSection(link.href);
                        return (
                            <li>
                                {children ? (
                                    <details class="index-folder" data-index-folder={link.href} open={sectionCurrent}>
                                        <summary>
                                            <a
                                                href={link.href}
                                                class:list={['index-link', { 'is-current': isCurrent(link.href) }]}
                                                aria-current={isCurrent(link.href) ? 'page' : undefined}
                                            >{link.text}</a>
                                            <span class="index-folder-mark" aria-hidden="true">+</span>
                                        </summary>
                                        <ul class="index-sublist">
                                            {children.map((child) => (
                                                <li>
                                                    <a
                                                        href={child.href}
                                                        class:list={['index-link index-sub-link', { 'is-current': isCurrent(child.href) }]}
                                                        aria-current={isCurrent(child.href) ? 'page' : undefined}
                                                    >{child.text}</a>
                                                </li>
                                            ))}
                                        </ul>
                                    </details>
                                ) : (
                                    <a
                                        href={link.href}
                                        class:list={['index-link', { 'is-current': sectionCurrent }]}
                                        aria-current={isCurrent(link.href) ? 'page' : undefined}
                                    >{link.text}</a>
                                )}
                            </li>
                        );
                    })}
                </ul>
            </div>
        ))}
    </div>

</nav>

<style>
    .index-panel {
        position: fixed;
        z-index: 60;
        inset: 0 auto 0 0;
        width: min(20rem, calc(100vw - 2.5rem));
        overflow-y: auto;
        padding: 1.5rem 1.5rem 2rem;
        border-right: 1px dashed rgb(var(--color-border-main) / .35);
        background: rgb(var(--color-bg-main));
        box-shadow: 6px 0 0 rgb(var(--color-text-main) / .06);
        visibility: hidden;
        transform: translateX(-105%);
        transition: transform .35s cubic-bezier(.2, .7, .2, 1), visibility .35s;
    }
    .site-index.is-open .index-panel {
        visibility: visible;
        transform: translateX(0);
    }
    .index-backdrop {
        position: fixed;
        z-index: 50;
        inset: 0;
        width: 100%;
        background: rgb(0 0 0 / .3);
        opacity: 0;
        visibility: hidden;
        transition: opacity .35s, visibility .35s;
    }
    .site-index.is-open .index-backdrop {
        opacity: 1;
        visibility: visible;
    }
    .index-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: .55rem;
        border-bottom: 1px dashed rgb(var(--color-border-main) / .32);
    }
    .index-eyebrow {
        font-family: 'Newsreader Variable', serif;
        font-size: 1.125rem;
        font-style: italic;
        line-height: 1.2;
        color: rgb(var(--color-text-main));
    }
    .index-eyebrow:hover { text-decoration: underline; text-underline-offset: 2px; }
    .index-group-label {
        font-size: .65rem;
        font-weight: 500;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: rgb(var(--color-text-main) / .62);
    }
    .index-close {
        font-family: 'Newsreader Variable', serif;
        font-size: .9rem;
        font-style: italic;
        line-height: 1.2;
        color: rgb(var(--color-text-main) / .62);
    }
    .index-close:hover { color: rgb(var(--color-text-main)); }
    .index-group {
        padding: .7rem 0;
        border-bottom: 1px dashed rgb(var(--color-border-main) / .22);
    }
    .index-group-label { margin: .25rem 0 .55rem; }
    .index-link {
        position: relative;
        display: block;
        width: fit-content;
        padding: .27rem .1rem .27rem 1rem;
        font-family: 'Newsreader Variable', serif;
        font-size: 1.125rem;
        line-height: 1.25;
        color: rgb(var(--color-text-main) / .65);
        transition: color .2s;
    }
    .index-folder > summary {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
    }
    .index-folder > summary::-webkit-details-marker { display: none; }
    .index-folder > summary > .index-link { flex: 1; }
    li > .index-link { width: 100%; }
    .index-folder-mark {
        padding: .2rem .1rem .2rem .3rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: .8rem;
        line-height: 1;
        color: rgb(var(--color-text-main) / .4);
        transition: transform .2s, color .2s;
    }
    .index-folder[open] > summary .index-folder-mark {
        color: rgb(var(--color-text-main) / .65);
        transform: rotate(45deg);
    }
    .index-sublist {
        margin: .1rem 0 .2rem 1rem;
        padding-left: .42rem;
        border-left: 1px dashed rgb(var(--color-border-main) / .22);
    }
    .index-sublist > li + li {
        margin-top: .36rem;
    }
    .index-sub-link {
        width: 100%;
        padding-top: .12rem;
        padding-bottom: .12rem;
        font-size: 1rem;
        line-height: 1.18;
        color: rgb(var(--color-text-main) / .53);
        white-space: normal;
    }
    .index-link::before {
        display: block;
        position: absolute;
        top: 50%;
        left: 0;
        width: .65rem;
        height: 1.25rem;
        font-family: 'Newsreader Variable', serif;
        font-size: 1.25rem;
        font-weight: 400;
        line-height: 1;
        color: currentColor;
        content: '~';
        transform: translateY(-50%) scaleX(0);
        transform-origin: left;
        transition: transform .2s;
    }
    .index-link:hover, .index-link:focus-visible, .index-link.is-current { color: rgb(var(--color-text-main)); }
    .index-link.is-current { font-style: italic; }
    .index-link:hover::before, .index-link:focus-visible::before, .index-link.is-current::before {
        transform: translateY(-50%) scaleX(1);
    }
    .index-panel:has(.index-link:not(.is-current):is(:hover, :focus-visible)) .index-link.is-current::before {
        transform: translateY(-50%) scaleX(0);
    }
    .index-link:focus-visible, .index-eyebrow:focus-visible, .index-close:focus-visible, .index-backdrop:focus-visible {
        outline: 2px solid rgb(var(--color-text-main));
        outline-offset: 3px;
    }
    .index-menu-icon { transition: width .2s; }
    .index-menu-icon::before, .index-menu-icon::after {
        content: '';
        position: absolute;
        top: 0;
        left: 50%;
        width: 1.5rem;
        height: 1px;
        background: currentColor;
        transform: translateX(-50%);
        transition: transform .2s, margin .2s;
    }
    .index-menu-icon::before { margin-top: -.375rem; }
    .index-menu-icon::after { margin-top: .375rem; }
    .site-index.is-open .index-menu-icon { width: 0; }
    .site-index.is-open .index-menu-icon::before { margin-top: 0; transform: translateX(-50%) rotate(45deg); }
    .site-index.is-open .index-menu-icon::after { margin-top: 0; transform: translateX(-50%) rotate(-45deg); }
    @media (min-width: 1280px) {
        .index-panel {
            position: sticky;
            inset: 2rem auto auto 0;
            width: calc(170px + .8rem);
            max-height: calc(100vh - 4rem);
            margin-inline: -.4rem;
            padding: 0 .4rem .4rem;
            overflow-y: auto;
            border: 0;
            background: transparent;
            box-shadow: none;
            visibility: visible;
            transform: none;
            transition: none;
        }
        .index-panel { scrollbar-width: none; }
        .index-panel::-webkit-scrollbar { display: none; }
        .index-panel.has-more {
            -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 5.5rem), rgb(0 0 0 / .3) calc(100% - 2rem), transparent);
            mask-image: linear-gradient(to bottom, #000 calc(100% - 5.5rem), rgb(0 0 0 / .3) calc(100% - 2rem), transparent);
        }
        .index-close, .index-backdrop { display: none; }
        .index-group { padding: .55rem 0; }
        .index-link { font-size: 1.05rem; }
        .index-sublist { width: auto; }
        .index-sub-link { font-size: .94rem; }
    }
    @media (max-width: 1279px) {
        .site-index.rail-only { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
        .index-panel, .index-backdrop, .index-link, .index-link::before, .index-menu-icon, .index-menu-icon::before, .index-menu-icon::after { transition: none; }
    }
</style>

<script>
    let cleanupIndex: (() => void) | undefined;

    function setupIndex(nav: HTMLElement) {
        const trigger = nav.querySelector<HTMLButtonElement>('.index-trigger');
        const panel = nav.querySelector<HTMLElement>('.index-panel');
        const closeButton = nav.querySelector<HTMLButtonElement>('.index-close');
        const backdrop = nav.querySelector<HTMLButtonElement>('.index-backdrop');
        if (!trigger || !panel || !closeButton || !backdrop) return;

        const folderStateKey = 'brandons-place:index-folders';
        const readFolderState = (): Record<string, boolean> => {
            try {
                const stored = window.localStorage.getItem(folderStateKey);
                const parsed = stored ? JSON.parse(stored) : null;
                return parsed && typeof parsed === 'object' ? parsed : {};
            } catch {
                return {};
            }
        };
        const writeFolderState = (state: Record<string, boolean>) => {
            try {
                window.localStorage.setItem(folderStateKey, JSON.stringify(state));
            } catch {
                // unavailable
            }
        };
        const folderDetails = Array.from(panel.querySelectorAll<HTMLDetailsElement>('[data-index-folder]'));
        const folderState = readFolderState();
        const openFolder = folderDetails.find((folder) => folder.open)
            ?? folderDetails.find((folder) => folderState[folder.dataset.indexFolder ?? '']);
        folderDetails.forEach((folder) => {
            folder.open = folder === openFolder;
        });

        const wideScreen = window.matchMedia('(min-width: 1280px)');
        function setOpen(open: boolean, restoreFocus = false) {
            nav.classList.toggle('is-open', open);
            trigger?.setAttribute('aria-expanded', String(open));
            trigger?.setAttribute('aria-label', open ? 'Close contents' : 'Open contents');
            if (open) window.setTimeout(() => {
                if (nav.classList.contains('is-open')) panel?.querySelector<HTMLAnchorElement>('a')?.focus();
            }, 360);
            else if (restoreFocus) trigger?.focus();
        }
        const toggle = () => setOpen(!nav.classList.contains('is-open'));
        const close = () => setOpen(false, true);
        const handleKeydown = (event: KeyboardEvent) => {
            if (event.key === 'Escape' && nav.classList.contains('is-open')) close();
        };
        const handleFocusOut = () => {
            window.requestAnimationFrame(() => {
                if (nav.classList.contains('is-open') && !panel.contains(document.activeElement) && document.activeElement !== trigger) setOpen(false);
            });
        };
        const handleViewport = () => setOpen(false);
        const updateOverflow = () => {
            panel.classList.toggle('has-more', panel.scrollTop + panel.clientHeight < panel.scrollHeight - 1);
        };
        const revealCurrent = () => {
            const current = panel.querySelector<HTMLElement>('.index-sub-link.is-current') ?? panel.querySelector<HTMLElement>('.index-link.is-current');
            if (!current || !wideScreen.matches) return;
            const hidden = current.getBoundingClientRect().bottom - panel.getBoundingClientRect().bottom + 48;
            if (hidden > 0) panel.scrollTop += hidden;
        };
        const handleLinkClick = () => setOpen(false);
        const handleFolderToggle = (event: Event) => {
            const folder = event.currentTarget;
            if (!(folder instanceof HTMLDetailsElement)) return;
            const href = folder.dataset.indexFolder;
            if (!href) return;
            const state = readFolderState();
            state[href] = folder.open;
            writeFolderState(state);
            if (folder.open) folderDetails.forEach((other) => {
                if (other !== folder) other.open = false;
            });
            updateOverflow();
        };

        trigger.addEventListener('click', toggle);
        closeButton.addEventListener('click', close);
        backdrop.addEventListener('click', close);
        panel.addEventListener('focusout', handleFocusOut);
        folderDetails.forEach((folder) => folder.addEventListener('toggle', handleFolderToggle));
        panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', handleLinkClick));
        document.addEventListener('keydown', handleKeydown);
        wideScreen.addEventListener('change', handleViewport);
        panel.addEventListener('scroll', updateOverflow, { passive: true });
        window.addEventListener('resize', updateOverflow);
        revealCurrent();
        updateOverflow();
        return () => {
            trigger.removeEventListener('click', toggle);
            closeButton.removeEventListener('click', close);
            backdrop.removeEventListener('click', close);
            panel.removeEventListener('focusout', handleFocusOut);
            folderDetails.forEach((folder) => folder.removeEventListener('toggle', handleFolderToggle));
            panel.querySelectorAll('a').forEach((link) => link.removeEventListener('click', handleLinkClick));
            document.removeEventListener('keydown', handleKeydown);
            wideScreen.removeEventListener('change', handleViewport);
            panel.removeEventListener('scroll', updateOverflow);
            window.removeEventListener('resize', updateOverflow);
        };
    }

    function initIndex() {
        cleanupIndex?.();
        const cleanups = Array.from(document.querySelectorAll<HTMLElement>('.site-index')).map(setupIndex);
        cleanupIndex = () => cleanups.forEach((cleanup) => cleanup?.());
    }

    document.addEventListener('astro:before-swap', () => { cleanupIndex?.(); cleanupIndex = undefined; });
    document.addEventListener('astro:page-load', initIndex);
    initIndex();
</script>
