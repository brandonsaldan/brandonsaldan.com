  .eu-photo--1 { top: 2rem; left: 3%; z-index: 4; }.eu-photo--2 { top: 12.8rem; left: 1%; z-index: 5; }.eu-photo--3 { top: 23.6rem; left: 2%; z-index: 6; }.eu-photo--4 { top: 2rem; left: 49%; z-index: 7; }.eu-photo--5 { top: 13.2rem; left: 49%; z-index: 8; }.eu-photo--6 { top: 23.4rem; left: 48%; z-index: 9; }

  .tampa-stage { min-height: 35rem; }
