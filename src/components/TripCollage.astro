  .catskills-stage { min-height: 33.5rem; }
  .catskills-photo { position: absolute; z-index: 3; width: 48%; height: 13rem; margin: 0; padding: .46rem .46rem .7rem; overflow: hidden; border-radius: .12rem; background: #fffdf8; box-shadow: 0 2px 4px rgb(54 45 32 / .14), 4px 14px 18px rgb(54 45 32 / .1), 9px 26px 33px rgb(54 45 32 / .05); transform-origin: 18% 82%; }
  .catskills-photo::before, .catskills-photo::after { position: absolute; inset: 0; pointer-events: none; content: ''; border-radius: inherit; }
