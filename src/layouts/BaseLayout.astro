---
import { ClientRouter } from 'astro:transitions';
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HomeNav from '../components/HomeNav.astro';
import Nav from '../components/Nav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

export type Props = HeadProps & { showHeader?: boolean; homeLayout?: boolean };

const { showHeader = true, homeLayout = false, ...head } = Astro.props;
---

<!doctype html>
<html lang="en" class="antialiased break-words overflow-x-clip">
    <head>
        <BaseHead {...head} />
        <slot name="head" />
        <script is:inline>
            (() => {
                const media = window.matchMedia('(prefers-color-scheme: dark)');
                const applyTheme = () => {
                    let stored = null;
                    try {
                        stored = localStorage.getItem('theme');
                    } catch {}
                    document.documentElement.classList.toggle('dark', stored ? stored === 'dark' : media.matches);
                };
                applyTheme();
                if (window.__themeListeners) return;
                window.__themeListeners = true;
                document.addEventListener('astro:after-swap', applyTheme);
                media.addEventListener('change', applyTheme);
            })();
        </script>
        <script>
            document.addEventListener('dragstart', (event) => {
                if (event.target instanceof HTMLImageElement) {
                    event.preventDefault();
                }
            });
        </script>
        <ClientRouter />
    </head>
    <body class:list={['bg-main text-main', { 'overflow-x-clip': Astro.url.pathname.replace(/\/$/, '') === '/travel' }]}>
        <div class="relative flex min-h-screen flex-col px-4 md:px-8">
            <div class="absolute right-4 top-4 z-10 md:right-8 md:top-8">
                <ThemeToggle />
            </div>
            {homeLayout ? (
                <>
                    <div class="home-intro">
                        <div class="home-mobile-nav"><Nav /></div>
                        <div class="home-desktop-nav"><HomeNav /></div>
                        {showHeader && <Header isHome />}
                        <main class="w-full"><slot name="intro" /></main>
                    </div>
                    <div class="home-gallery"><slot name="gallery" /></div>
                    <div class="site-shell home-content flex-1">
                        <Nav railOnly />
                        <section class="site-content w-full" aria-label="Selected work"><slot /></section>
                    </div>
                </>
            ) : (
                <div class="site-shell site-body flex-1">
                    <Nav />
                    <div class="site-content">
                        {showHeader && <Header />}
                        <main class="w-full"><slot /></main>
                    </div>
                </div>
            )}
            <slot name="full-width" />
            <div class="site-shell site-footer">
                <div class="site-footer-content"><Footer /></div>
            </div>
        </div>
    </body>
</html>

<style>
    .site-shell {
        width: 100%;
        max-width: 48rem;
        margin-inline: auto;
    }
    .site-content, .site-footer-content { min-width: 0; }
    .home-intro { width: 100%; max-width: 48rem; margin-inline: auto; }
    .home-mobile-nav { display: none; }
    .home-gallery {
        position: relative;
        z-index: 2;
        left: 50%;
        width: 100vw;
        margin-top: 1.5rem;
        margin-left: -50vw;
    }
    .home-content { padding-top: 2.5rem; }
    @media (max-width: 639px) {
        .home-content { padding-top: 2.25rem; }
    }
    @media (max-width: 1279px) {
        .home-mobile-nav { display: block; }
        .home-desktop-nav { display: none; }
    }
    @media (min-width: 640px) {
        .home-gallery { margin-top: 4rem; }
        .home-content { padding-top: 4.5rem; }
    }
    @media (min-width: 1280px) {
        .site-shell {
            max-width: 978px;
            display: grid;
            grid-template-columns: 170px minmax(0, 48rem);
            column-gap: 40px;
        }
        .site-body { padding-top: 6rem; }
        .site-content, .site-footer-content { grid-column: 2; }
    }
</style>
