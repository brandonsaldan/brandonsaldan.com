---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ogCard } from '../../utils/image-utils';
import { personRef } from '../../utils/structured-data';
import Pagination from '../../components/Pagination.astro';
import PostPreview from '../../components/PostPreview.astro';
import PreviewBlock from '../../components/PreviewBlock.astro';
import siteConfig from '../../data/site-config';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
    return paginate(posts, { pageSize: siteConfig.postsPerPage || 4 });
}

type Props = { page: Page<CollectionEntry<'blog'>> };

const { page } = Astro.props;
const blog = page.data;
---

<BaseLayout
    title="Blog"
    description="Writing on technology, the projects I build, and the research I publish. Most posts start from something I’ve made or a paper I’ve written."
    image={ogCard('blog', 'Blog')}
    page={{ '@type': 'CollectionPage', about: personRef }}
    showHeader={false}
>
    <h1 class="mb-3 text-4xl leading-tight font-serif italic sm:mb-4 sm:text-4xl">Blog</h1>
    <p class="mb-10 text-base leading-relaxed sm:mb-10 sm:text-lg">Writing on technology, the projects I build, and the research I publish. Most posts start from something I’ve made or a paper I’ve written.</p>
    <div>
        {blog.map((post, index) => (
            <PreviewBlock index={index} image={post.data.image} href={`/blog/${post.id}/`}>
                <PostPreview post={post} showMeta={false} />
            </PreviewBlock>
        ))}
    </div>
    <Pagination page={page} class="my-16 sm:my-24" />
</BaseLayout>
