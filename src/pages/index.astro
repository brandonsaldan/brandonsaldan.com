---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import PostPreview from '../components/PostPreview.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import PreviewBlock from '../components/PreviewBlock.astro';
import ResearchPreview from '../components/ResearchPreview.astro';
import siteConfig from '../data/site-config';
import { sortItemsByDateDesc } from '../utils/data-utils';
import { personRef } from '../utils/structured-data';

const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
const featuredPosts = posts.filter(({ data }) => data.isFeatured).slice(0, 3);

const projects = (await getCollection('projects')).sort(sortItemsByDateDesc);
const featuredProjects = projects.filter(({ data }) => data.isFeatured);

const research = (await getCollection('research')).sort(sortItemsByDateDesc);
const featuredResearch = research.filter(({ data }) => data.isFeatured);
---

<BaseLayout description={siteConfig.description} image={siteConfig.image} page={{ '@type': 'ProfilePage', mainEntity: personRef, about: personRef }} homeLayout>
    <Hero slot="intro" />
    <PhotoGallery slot="gallery" />
    {
        featuredProjects?.length > 0 && (
            <div class="mb-16 sm:mb-24">
                <div class="flex items-baseline justify-between mb-8 sm:mb-12">
                    <h2 class="text-3xl font-serif italic sm:text-2xl">Selected Projects</h2>
                    <span class="text-base font-serif italic text-neutral-600 dark:text-neutral-400">
                        {featuredProjects.length} {featuredProjects.length === 1 ? 'project' : 'projects'}
                    </span>
                </div>
                <div>
                    {featuredProjects.map((project, index) => (
                        <PreviewBlock index={index} image={project.data.image} href={`/projects/${project.id}/`}>
                            <ProjectPreview project={project} headingLevel="h3" />
                        </PreviewBlock>
                    ))}
                </div>
                <div class="mt-12 sm:mt-16 text-center">
                    <Button href="/projects/">View All Projects</Button>
                </div>
            </div>
        )
    }
    {
        featuredResearch?.length > 0 && (
            <div class="mb-16 sm:mb-24">
                <div class="flex items-baseline justify-between mb-8 sm:mb-12">
                    <h2 class="text-3xl font-serif italic sm:text-2xl">Recent Research</h2>
                    <span class="text-base font-serif italic text-neutral-600 dark:text-neutral-400">
                        {featuredResearch.length} {featuredResearch.length === 1 ? 'paper' : 'papers'}
                    </span>
                </div>
                <div>
                    {featuredResearch.map((paper, index) => (
                        <PreviewBlock index={index} image={paper.data.image} href={`/research/${paper.id}/`}>
                            <ResearchPreview paper={paper} headingLevel="h3" showMeta={false} />
                        </PreviewBlock>
                    ))}
                </div>
                <div class="mt-12 sm:mt-16 text-center">
                    <Button href="/research/">View All Research</Button>
                </div>
            </div>
        )
    }
    {
        featuredPosts?.length > 0 && (
            <div class="mb-16 sm:mb-24">
                <div class="flex items-baseline justify-between mb-8 sm:mb-12">
                    <h2 class="text-3xl font-serif italic sm:text-2xl">Recent Writing</h2>
                    <span class="text-base font-serif italic text-neutral-600 dark:text-neutral-400">
                        {featuredPosts.length} {featuredPosts.length === 1 ? 'post' : 'posts'}
                    </span>
                </div>
                <div>
                    {featuredPosts.map((post, index) => (
                        <PreviewBlock index={index} image={post.data.image} href={`/blog/${post.id}/`}>
                            <PostPreview post={post} headingLevel="h3" showMeta={false} />
                        </PreviewBlock>
                    ))}
                </div>
                <div class="mt-12 sm:mt-16 text-center">
                    <Button href="/blog/">View All Posts</Button>
                </div>
            </div>
        )
    }
</BaseLayout>
