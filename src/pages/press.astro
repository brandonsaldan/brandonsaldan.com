---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ogCard } from '../utils/image-utils';
import { press, type PressMention } from '../data/press';
import { absoluteURL, personRef, projectRef } from '../utils/structured-data';

const description = 'Every so often my work ends up somewhere I didn’t expect. Here’s where it’s been written about, quoted, or talked through on air.';
const formatDate = (date: string) => new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const featured = press.filter((item) => item.featured);
const more = press.filter((item) => !item.featured).sort((a, b) => b.date.localeCompare(a.date));
const headline = (item: PressMention) => {
    const text = `${item.title}${item.segment ? ` (from ${item.segment})` : ''}`;
    const at = text.lastIndexOf(' ');
    return { lead: text.slice(0, at + 1), last: text.slice(at + 1) };
};
const pageURL = absoluteURL('/press/');
const coverage = [...featured, ...more].map((item) => {
    const video = new URL(item.href).hostname.endsWith('youtube.com');
    return {
        '@type': video ? 'CreativeWork' : 'NewsArticle',
        '@id': `${pageURL}#${item.outlet.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
        ...(video
            ? { name: item.title, url: item.href, datePublished: `${item.date}T00:00:00Z` }
            : { headline: item.title, url: item.href, datePublished: `${item.date}T00:00:00Z` }),
        author: item.author ? { '@type': 'Person', name: item.author } : undefined,
        publisher: { '@type': 'Organization', name: item.outlet },
        about: projectRef(item.project),
        mentions: item.namesMe ? personRef : undefined
    };
});
const projects = (await getCollection('projects')).filter(({ id }) => press.some(({ project }) => project === id));
const schema = [
    {
        '@type': 'ItemList',
        '@id': `${pageURL}#coverage`,
        name: 'Press coverage',
        numberOfItems: coverage.length,
        itemListElement: coverage.map((item, index) => ({ '@type': 'ListItem', position: index + 1, item }))
    },
    ...projects.map(({ id, data }) => ({
        '@type': 'SoftwareSourceCode',
        ...projectRef(id),
        name: data.title.split(': ')[0],
        url: data.website ?? absoluteURL(`/projects/${id}/`),
        author: personRef
    })),
    { ...personRef, subjectOf: coverage.filter(({ mentions }) => mentions).map((item) => ({ '@id': item['@id'] })) }
];
---

<BaseLayout
    title="Press"
    image={ogCard('press', 'Press')}
    description="Press coverage of Brandon Saldan’s work, including Nocturne in Ars Technica, Gizmodo, TechSpot, and Linus Tech Tips’ WAN Show."
    page={{ '@type': 'CollectionPage', about: personRef, mainEntity: { '@id': `${pageURL}#coverage` } }}
    schema={schema}
    showHeader={false}
>
    <h1 class="mb-3 text-4xl leading-tight font-serif italic sm:mb-4 sm:text-4xl">Press</h1>
    <p class="mb-10 text-base leading-relaxed sm:text-lg">{description}</p>

    <div class="mb-16 sm:mb-24">
        <section class="press-section" aria-labelledby="press-featured">
            <h2 id="press-featured" class="press-label">Featured</h2>
            <ul class="press-featured">
                {featured.map((item) => (
                    <li>
                        <div class="press-head">
                            <h3 class="press-outlet">{item.outlet}</h3>
                            <span class="press-date">{item.author && <>{item.author} · </>}<time datetime={item.date}>{formatDate(item.date)}</time></span>
                        </div>
                        {item.quote && <blockquote class="press-quote">“{item.quote}”</blockquote>}
                        <p class="press-source">
                            <a class="press-link" href={item.href} target="_blank" rel="noopener noreferrer">{headline(item).lead}<span class="press-last">{headline(item).last}</span></a>
                        </p>
                    </li>
                ))}
            </ul>
        </section>

        <section class="press-section" aria-labelledby="press-more">
            <h2 id="press-more" class="press-label">More coverage</h2>
            <ul class="press-list">
                {more.map((item) => (
                    <li>
                        <span class="press-list-main">
                            <span class="press-list-outlet">{item.outlet}</span>
                            <a class="press-link" href={item.href} target="_blank" rel="noopener noreferrer">{headline(item).lead}<span class="press-last">{headline(item).last}</span></a>
                        </span>
                        <time class="press-date" datetime={item.date}>{formatDate(item.date)}</time>
                    </li>
                ))}
            </ul>
        </section>
    </div>
</BaseLayout>

<style>
    .press-section {
        display: grid;
        gap: .9rem;
        padding-block: 1.6rem;
        border-top: 1px dashed rgb(var(--color-border-main) / .35);
    }
    .press-section:first-child { padding-top: 0; border-top: 0; }
    @media (min-width: 768px) {
        .press-section { grid-template-columns: 9.5rem minmax(0, 1fr); gap: 1.5rem; }
        .press-section > .press-label { padding-top: .6rem; }
    }
    .press-label {
        font-size: .65rem;
        font-weight: 500;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: rgb(var(--color-text-main) / .62);
    }
    .press-date {
        font-family: 'Newsreader Variable', serif;
        font-size: .92rem;
        font-style: italic;
        white-space: nowrap;
        color: rgb(var(--color-text-main) / .65);
    }
    .press-link {
        text-decoration: underline dashed 1px rgb(var(--color-text-main) / .35);
        text-underline-offset: 3px;
        transition: text-decoration-color .2s;
    }
    .press-link:hover { text-decoration-color: rgb(var(--color-text-main)); text-decoration-style: solid; }
    .press-last { white-space: nowrap; }
    .press-last::after { font-family: 'Newsreader Variable', serif; content: ' ↗'; }

    .press-featured { display: grid; gap: 2.25rem; }
    .press-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .2rem 1rem; }
    .press-outlet {
        font-family: 'Newsreader Variable', serif;
        font-size: 1.6rem;
        font-weight: 500;
        line-height: 1.2;
    }
    .press-quote {
        margin-top: .6rem;
        font-family: 'Newsreader Variable', serif;
        font-size: 1.15rem;
        font-style: italic;
        line-height: 1.55;
        color: rgb(var(--color-text-main) / .85);
    }
    .press-source {
        margin-top: .6rem;
        font-size: .88rem;
        line-height: 1.5;
        color: rgb(var(--color-text-main) / .65);
    }

    .press-list { display: grid; gap: 1.1rem; }
    .press-list li {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: baseline;
        gap: .2rem 1rem;
    }
    .press-list-main { display: flex; flex-direction: column; gap: .1rem; min-width: 0; }
    .press-list-outlet {
        font-family: 'Newsreader Variable', serif;
        font-size: 1.15rem;
        font-weight: 500;
        line-height: 1.3;
    }
    .press-list .press-link { font-size: .88rem; line-height: 1.5; color: rgb(var(--color-text-main) / .65); }
    @media (max-width: 639px) {
        .press-list li { grid-template-columns: minmax(0, 1fr); }
        .press-list .press-date { grid-row: 1; }
    }
</style>
