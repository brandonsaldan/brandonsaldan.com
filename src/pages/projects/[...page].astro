---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import PreviewBlock from '../../components/PreviewBlock.astro';
import siteConfig from '../../data/site-config';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const projects = (await getCollection('projects')).sort(sortItemsByDateDesc);
    return paginate(projects, { pageSize: siteConfig.projectsPerPage || 6 });
}

type Props = { page: Page<CollectionEntry<'projects'>> };

const { page } = Astro.props;
const portfolio = page.data;
---

<BaseLayout
    title="Projects"
    description="Software, products, and experiments built across engineering, design, and the spaces where technical work meets everyday life."
    image={{ src: '/og/projects.png', alt: 'Portfolio' }}
    showHeader={false}
>
    <h1 class="mb-3 text-4xl leading-tight font-serif italic sm:mb-4 sm:text-4xl">Projects</h1>
    <p class="mb-10 text-base leading-relaxed sm:mb-10 sm:text-lg">Software, products, and experiments built across engineering, design, and the spaces where technical work meets everyday life.</p>
    <div>
        {portfolio.map((project, index) => (
        <PreviewBlock index={index} image={project.data.image} href={`/projects/${project.id}/`}>
                <ProjectPreview project={project} />
            </PreviewBlock>
        ))}
    </div>
    <Pagination page={page} class="my-16 sm:my-24" />
</BaseLayout>
