---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ogCard } from '../utils/image-utils';
import { personRef } from '../utils/structured-data';
import PreviewBlock from '../components/PreviewBlock.astro';
import ResearchPreview from '../components/ResearchPreview.astro';
import { sortItemsByDateDesc } from '../utils/data-utils';

const papers = (await getCollection('research')).sort(sortItemsByDateDesc);
---

<BaseLayout
    title="Research"
    description="Selected research and long-form inquiry by Brandon Saldan into institutions, technology, culture, and public life."
    image={ogCard('research', 'Research')}
    page={{ '@type': 'CollectionPage', about: personRef }}
    showHeader={false}
>
    <h1 class="mb-3 text-4xl leading-tight font-serif italic sm:mb-4 sm:text-4xl">Research</h1>

    <p class="mb-10 text-base leading-relaxed sm:mb-10 sm:text-lg">
        Selected research and long-form inquiry into institutions, technology, culture, and the systems that shape public life.
    </p>

    <div>
        {papers.map((paper, index) => (
            <PreviewBlock index={index} image={paper.data.image} href={`/research/${paper.id}/`}>
                <ResearchPreview paper={paper} showMeta={false} />
                <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">
                    DOI: <a class="underline decoration-dashed decoration-1 underline-offset-2 hover:decoration-solid" href={`https://doi.org/${paper.data.doi}`}>{paper.data.doi}</a>
                </p>
            </PreviewBlock>
        ))}
    </div>
</BaseLayout>
