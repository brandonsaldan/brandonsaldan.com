        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: baseline;
        gap: 1rem;
    }
    .resume-ledger .resume-title { font-size: 1.05rem; }
    .resume-ledger--compact { gap: .6rem; }
    .resume-credential { font-size: .95rem; color: rgb(var(--color-text-main)); }
    .resume-note { margin-top: .35rem; font-size: .92rem; line-height: 1.55; }

    @media (prefers-reduced-motion: reduce) {
        .resume-fn, .resume-footnote, .resume-paper-panel, .resume-mark, .resume-item, .resume-label, .resume-lenses a, .resume-lenses a::before, .resume-duration { transition: none; animation: none; }
    }
</style>

<script>
    function initResume() {
        const toggle = document.querySelector<HTMLButtonElement>('[data-resume-toggle]');
        const documentEl = document.querySelector<HTMLElement>('[data-resume-document]');
        if (!toggle || !documentEl || toggle.dataset.initialized) return;
        toggle.dataset.initialized = 'true';
        const entries = Array.from(documentEl.querySelectorAll<HTMLDetailsElement>('.resume-entry'));
        const items = Array.from(documentEl.querySelectorAll<HTMLElement>('.resume-item'));
        const lensLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-resume-lens]'));

        const sync = () => {
            const allOpen = entries.every((entry) => entry.open);
            toggle.textContent = allOpen ? 'Collapse all' : 'Expand all';
            toggle.setAttribute('aria-pressed', String(allOpen));
        };

        const setLens = (lens: string) => {
            if (!lensLinks.some((link) => link.dataset.resumeLens === lens)) lens = '';
            lensLinks.forEach((link) => link.toggleAttribute('aria-current', link.dataset.resumeLens === lens));
            if (lens) documentEl.dataset.lens = lens;
            else delete documentEl.dataset.lens;
            items.forEach((item) => {
                const match = !lens || (item.dataset.lenses ?? '').split(' ').includes(lens);
                item.classList.toggle('is-match', Boolean(lens) && match);
                if (item instanceof HTMLDetailsElement) item.open = match;
            });
            sync();
        };

        const showNote = (number: string, open = true) => {
            const marker = document.getElementById(`resume-ref-${number}`);
            const note = document.getElementById(`resume-inline-${number}`);
            if (!marker || !note) return;
            note.hidden = !open;
            marker.setAttribute('aria-expanded', String(open));
            if (open) marker.closest('details')?.setAttribute('open', '');
            return marker;
        };
        documentEl.querySelectorAll<HTMLAnchorElement>('.resume-fn').forEach((marker) => {
            marker.addEventListener('click', (event) => {
                event.preventDefault();
                showNote(marker.textContent ?? '', marker.getAttribute('aria-expanded') !== 'true');
            });
        });
        documentEl.querySelectorAll<HTMLAnchorElement>('[data-resume-backref]').forEach((link) => {
            link.addEventListener('click', (event) => {
                event.preventDefault();
                const marker = showNote(link.dataset.resumeBackref ?? '');
                marker?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                marker?.focus({ preventScroll: true });
            });
        });

        documentEl.querySelectorAll<HTMLButtonElement>('[data-resume-panel]').forEach((button) => {
            button.addEventListener('click', () => {
                const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
                if (!panel) return;
                panel.hidden = !panel.hidden;
                button.setAttribute('aria-expanded', String(!panel.hidden));
            });
        });

        documentEl.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
            button.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(button.dataset.copy ?? '');
                    button.textContent = 'Copied';
                } catch {
                    button.textContent = 'Couldn’t copy';
                }
                window.setTimeout(() => { button.textContent = 'Copy'; }, 1600);
            });
        });

        toggle.addEventListener('click', () => {
            const open = !entries.every((entry) => entry.open);
            entries.forEach((entry) => { entry.open = open; });
            sync();
        });
        entries.forEach((entry) => entry.addEventListener('toggle', sync));
        lensLinks.forEach((link) => link.addEventListener('click', (event) => {
            event.preventDefault();
            const lens = link.dataset.resumeLens ?? '';
            const url = new URL(window.location.href);
            if (lens) url.searchParams.set('for', lens);
            else url.searchParams.delete('for');
            history.replaceState(history.state, '', url);
            setLens(lens);
        }));

        setLens(new URLSearchParams(window.location.search).get('for') ?? '');
    }

    document.addEventListener('astro:page-load', initResume);
</script>
