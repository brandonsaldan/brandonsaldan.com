---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ogCard } from '../utils/image-utils';
import TripCollage from '../components/TripCollage.astro';
import travelData from '../data/travel-data';

const trips = [
  {
    name: 'La Altagracia',
    date: 'Jun 2007',
    sortKey: '2007-06',
    places: 'Dominican Republic',
    detail: 'Punta Cana',
    mode: 'air',
    scene: 'punta',
    intro: 'My first flight and real trip. I was too young to remember much, but I do remember trying to order chocolate milk at a restaurant. What arrived was milk with chocolate sticks in it, and after a few unsuccessful attempts by my parents to explain in English what I meant, I finally offered, “leche chocolate!” an imperfect bit of Spanish I had probably picked up from watching Dora the Explorer. I don’t actually remember whether that worked either, but apparently my attempt got a laugh out of the restaurant staff.',
  },
  {
    name: 'Newfoundland',
    date: 'Jul 2018',
    sortKey: '2018-07',
    places: 'Canada',
    detail: 'Twillingate, Cape Spear, St. John’s, Gander',
    mode: 'air',
    scene: 'notebook',
    intro: 'A trip to visit family and see the island from its beaches and cliffs. We stood at Cape Spear, the easternmost point in mainland North America, walked through the World War I trench recreation in Elliston, and fired a Lee-Enfield and an (inert) grenade launcher. By the end, I had also learned how to gut, clean, and cook a cod.',
    slides: [
      { label: 'puffins', image: '/photos/newfoundland-puffins.webp', caption: 'puffins' },
      { label: 'harbor', image: '/photos/newfoundland-harbor.webp', caption: 'harbor view' },
      { label: 'the lighthouse', image: '/photos/newfoundland-lighthouse.webp', caption: 'long point', alt: 'The Long Point Lighthouse sign in Newfoundland' },
      { label: 'the catch', image: '/photos/newfoundland-fishing.webp', caption: 'preparing the catch', alt: 'Cleaning a fish in Newfoundland' },
      { label: 'the range', image: '/photos/newfoundland-range-display.webp', caption: 'at the range', alt: 'A shooting range in Newfoundland' },
      { label: 'the coast', image: '/photos/newfoundland-flag.webp', caption: 'a good wind' },
    ],
  },
  {
    name: 'Central Europe',
    date: 'Apr 2019',
    sortKey: '2019-04',
    places: 'Germany · Czechia · Poland · Slovakia · Hungary',
    detail: 'Berlin, Dresden, Prague, Kraków, Oświęcim, Košice, Budapest',
    mode: 'air',
    scene: 'foldout',
    intro: 'A school trip during my sophomore year took us through five countries, mostly by bus with a few long train rides. We visited war museums in Berlin, had a day to explore Prague on our own, toured the Wieliczka Salt Mine and Auschwitz, and spent time exploring Budapest. I had plenty of beer, bratwurst, and pretzels in Germany, and incredible pierogi in Poland. It was an amazing trip, and I met many great people along the way.',
    slides: [
      { label: 'Berlin', image: '/photos/europe-berlin-reichstag.webp', caption: 'the reichstag' },
      { label: 'Prague', image: '/photos/europe-prague-clock.webp', caption: 'prague astronomical clock' },
      { label: 'Prague', image: '/photos/europe-statue.webp', caption: 'on charles bridge, prague' },
      { label: 'Prague', image: '/photos/europe-church.webp', caption: 'church of saint nicholas, prague' },
      { label: 'Kraków', image: '/photos/europe-wawel-cathedral.webp', caption: 'wawel cathedral, kraków' },
      { label: 'Budapest', image: '/photos/europe-budapest-basilica.webp', caption: 'st. stephen’s basilica, budapest' },
    ],
  },
  {
    name: 'Tampa Bay',
    date: 'Jul 2022',
    sortKey: '2022-07',
    places: 'Florida',
    detail: 'St. Petersburg, Clearwater, Pinellas Park',
    mode: 'photo journal',
    scene: 'tampa-scrapbook',
    intro: 'I met up with some of my closest friends, most of whom I had only known online through software development. We watched incredible sunsets, raced go-karts more times than I can count, and met glaive backstage before his concert. After the show, his touring drummer gave me one of the sticks he had played with and signed it for me, which meant even more because I play drums too. (Thank you Devin!)',
    slides: [
      { label: 'The water', image: '/photos/tampa-sunset.webp', caption: 'last light', alt: 'Sunset over the water in Tampa Bay' },
      { label: 'Sand Key', image: '/photos/tampa-sand-key.webp', caption: 'first group pic', alt: 'Friends together at Sand Key' },
      { label: 'St. Pete', image: '/photos/tampa-st-petersburg-night.webp', caption: 'after dark', alt: 'Friends together at night in St. Petersburg' },
      { label: 'The Orpheum', image: '/photos/tampa-orpheum.webp', caption: 'before the show', alt: 'Backstage with the band at the Orpheum' },
    ],
  },
  {
    name: 'Nassau',
    date: 'Apr 2023',
    sortKey: '2023-04',
    places: 'The Bahamas',
    detail: 'Charleston, Half Moon Cay',
    mode: 'sea',
    scene: 'ship-log',
    intro: 'My first cruise. I spent a day walking around Nassau, got yelled at by street vendors when I passed on their sunglasses, and spent a couple of hours on the beach at Half Moon Cay.',
    slides: [
      { label: 'At sea', image: '/photos/bahamas-at-sea.webp', caption: 'committing code in the middle of the ocean' },
      { label: 'On board', image: '/photos/bahamas-ship-interior-display.webp', caption: 'the ship’s atrium' },
      { label: 'Tender ride', image: '/photos/bahamas-tender-display.webp', caption: 'between ship and shore' },
      { label: 'Nassau', image: '/photos/bahamas-nassau-building-display.webp', caption: 'a morning in nassau' },
    ],
  },
  {
    name: 'Catskill Mountains',
    date: 'Oct 2024',
    sortKey: '2024-10',
    places: 'New York',
    detail: 'Hudson, Athens',
    mode: 'photo journal',
    scene: 'scorecard',
    intro: 'The first Bagel Fund meetup took us by train from Penn Station up to the mountains. We made steak with garlic truffle butter, beat the odds by building a fire after recent rain soaked the wood and kindling, roasted marshmallows, hiked part of the mountains, and skipped plenty of rocks across the lake.',
    slides: [
      { label: 'The lake', image: '/photos/catskills-lake.webp', caption: 'on the lake' },
      { label: 'The team', image: '/photos/catskills-bagel-fund.webp', caption: 'bagel fund team' },
      { label: 'The road', image: '/photos/catskills-fall-road.webp', caption: 'great sights in the fall' },
      { label: 'The fire', image: '/photos/catskills-fire-display.webp', caption: 'building the fire' },
    ],
  },
  {
    name: 'Caribbean',
    date: 'Feb 2026',
    sortKey: '2026-02',
    places: 'The Bahamas · Turks and Caicos · Dominican Republic',
    detail: 'Half Moon Cay, Grand Turk, Amber Cove',
    mode: 'sea',
    scene: 'port-pass',
    intro: 'Weather left us stranded in port for a while, but there was plenty to do on board. We watched the Super Bowl in the ship’s theater, had French toast with peach compote for breakfast, drank plenty of piña coladas, and I won a little over $800 in the casino.',
    slides: [
      { label: 'The theater', image: '/photos/caribbean-theater-display.webp', caption: 'super bowl watch party' },
      { label: 'Dinner', image: '/photos/caribbean-dinner-display.webp', caption: 'demolished' },
      { label: 'The pool deck', image: '/photos/caribbean-pool-deck-display.webp', caption: 'pool deck' },
      { label: 'On shore', image: '/photos/caribbean-beach-display.webp', caption: 'on shore' },
      { label: 'The casino', image: '/photos/caribbean-slots-display.webp', caption: 'a lucky night' },
    ],
  },
];

const futurePlaces = [
  'Afghanistan', 'Antarctica', 'Bosnia and Herzegovina', 'Cambodia', 'Chile',
  'Cuba', 'El Salvador', 'Greenland', 'Iran', 'Iraq', 'Israel', 'Italy', 'Kosovo',
  'Morocco', 'Myanmar', 'New Zealand', 'North Korea', 'Palestine (West Bank)',
  'Russia', 'Rwanda', 'Serbia', 'Singapore', 'South Africa', 'South Korea',
  'Spain', 'Taiwan', 'Transnistria', 'Turkmenistan', 'Ukraine',
  'United Arab Emirates', 'United Kingdom', 'Vietnam', 'Western Sahara',
  'Zimbabwe',
];

const placesOnMyMind = [
  'Antarctica', 'Greenland', 'Morocco', 'New Zealand', 'Singapore', 'Vietnam',
];
const otherFuturePlaces = futurePlaces.filter((place) => !placesOnMyMind.includes(place));
const timelineTrips = [...trips].sort((a, b) => a.sortKey.localeCompare(b.sortKey));

const statesCount = travelData.states.filter((state) => state.name !== 'Washington, DC').length;
const journeyGroups = Array.from(
  travelData.journeys.reduce((groups, journey) => {
    const year = journey.date?.split('-')[1] ?? 'Undated';
    const group = groups.get(year) ?? [];
    group.push(journey);
    groups.set(year, group);
    return groups;
  }, new Map<string, typeof travelData.journeys>())
).reverse();
---

<BaseLayout
  title="Travel"
  description="Brandon Saldan’s personal travel index: standout trips, countries visited, a full route log, and places still on my mind."
  image={ogCard('travel', 'Travel')}
  showHeader={false}
>
  <h1 class="mb-3 text-4xl leading-tight font-serif italic sm:mb-4 sm:text-4xl">Travel</h1>
  <p class="mb-12 max-w-3xl text-base leading-relaxed sm:mb-10 sm:text-lg">
    I like going places. Here are a few trips that stand out, along with the places I’ve been and the ones I’d still like to see.
  </p>

  <section class="mb-16 sm:mb-24" aria-labelledby="trips-heading">
    <h2 id="trips-heading" class="sr-only">Trips that stand out</h2>

    <div class="travel-timeline" data-travel-timeline>
      <div class="travel-timeline-status sr-only" aria-live="polite">
        <span data-timeline-count>Trip 01 / {String(timelineTrips.length).padStart(2, '0')}</span>
        <span data-timeline-date>{timelineTrips[0].date}</span>
      </div>

      <div class="travel-timeline-entries">
        <span class="travel-timeline-line-progress" data-timeline-line-progress aria-hidden="true"></span>
        {timelineTrips.map((trip) => (
          <article
            class:list={['travel-timeline-entry', { 'travel-timeline-entry--punta': trip.scene === 'punta', 'travel-timeline-entry--notebook': trip.scene === 'notebook', 'travel-timeline-entry--foldout': trip.scene === 'foldout', 'travel-timeline-entry--tampa-scrapbook': trip.scene === 'tampa-scrapbook', 'travel-timeline-entry--ship-log': trip.scene === 'ship-log', 'travel-timeline-entry--scorecard': trip.scene === 'scorecard', 'travel-timeline-entry--port-pass': trip.scene === 'port-pass' }]}
            data-timeline-entry
            data-timeline-date={trip.date}
          >
            <time class="sr-only">{trip.date}</time>
            <span class="travel-timeline-marker" data-marker-date={trip.date} aria-hidden="true"></span>
            <div class="travel-timeline-card">
              <h3 class="font-serif text-3xl leading-[1.05] sm:text-4xl">{trip.name}</h3>
              <p class="trip-place text-sm leading-relaxed sm:text-base">{trip.places}</p>
              <p class="trip-detail font-serif text-sm italic leading-relaxed text-main/50">{trip.detail}</p>
              <p class="trip-intro font-serif text-[0.94rem] italic leading-[1.4]">{trip.intro}</p>
              {trip.scene === 'punta' ? (
                <div class="punta-scene" data-punta-scene>
                  <div class="punta-scene-stage">
                    <div class="punta-scene-objects">
                      <div class="punta-passport" aria-hidden="true">
                        <img class="punta-passport-cover-image" src="/photos/punta-cana-passport.webp" alt="" decoding="async" />
                      </div>
                      <figure class="punta-flight-photo">
                        <img src="/photos/punta-cana-flight.webp" alt="Brandon as a child on his first flight to Punta Cana" decoding="async" fetchpriority="high" />
                        <figcaption>first flight</figcaption>
                      </figure>
                      <div class="punta-ticket">
                        <div class="punta-ticket-main">
                          <div class="punta-ticket-meta"><span>boarding pass</span><span></span></div>
                          <span class="punta-ticket-barcode" aria-hidden="true"></span>
                          <div class="punta-ticket-route">
                            <span class="punta-ticket-airport"><strong>PHL</strong><small>Philadelphia</small></span>
                            <span class="punta-route-path" aria-hidden="true">
                              <svg viewBox="0 0 120 34" preserveAspectRatio="none" role="presentation"><path d="M1 16C33 -8 87 -8 119 16" /></svg>
                              <svg class="punta-route-plane" viewBox="0 0 24 24" role="presentation"><path d="M22 16.21v-1.895L14 8V4a2 2 0 0 0-4 0v4.105L2 14.42v1.789l8-2.81V18l-3 2v2l5-2 5 2v-2l-3-2v-4.685l8 2.895z" /></svg>
                            </span>
                            <span class="punta-ticket-airport"><strong>PUJ</strong><small>Punta Cana</small></span>
                          </div>
                          <div class="punta-ticket-details">
                            <span><small>Passenger</small><strong>Brandon Saldan</strong></span>
                            <span><small>Flight</small><strong>First</strong></span>
                            <span><small>Seat</small><strong>23A</strong></span>
                          </div>
                        </div>
                        <div class="punta-ticket-stub punta-ticket-stub--anchor">
                          <div class="punta-ticket-stub-surface">
                            <div class="punta-stub-route">
                              <span><small>From</small><strong>PHL</strong><em>Philadelphia</em></span>
                              <span><small>To</small><strong>PUJ</strong><em>Punta Cana</em></span>
                            </div>
                            <div class="punta-stub-details">
                              <span class="punta-stub-passenger"><small>Passenger</small><strong>Brandon Saldan</strong></span>
                              <span><small>Flight</small><strong>First</strong></span>
                              <span><small>Seat</small><strong>23A</strong></span>
                            </div>
                            <span class="punta-stub-barcode" aria-hidden="true"></span>
                          </div>
                        </div>
                        <div class="punta-ticket-stub punta-ticket-stub--torn">
                          <div class="punta-ticket-stub-surface">
                            <div class="punta-stub-route">
                              <span><small>From</small><strong>PHL</strong><em>Philadelphia</em></span>
                              <span><small>To</small><strong>PUJ</strong><em>Punta Cana</em></span>
                            </div>
                            <div class="punta-stub-details">
                              <span class="punta-stub-passenger"><small>Passenger</small><strong>Brandon Saldan</strong></span>
                              <span><small>Flight</small><strong>First</strong></span>
                              <span><small>Seat</small><strong>23A</strong></span>
                            </div>
                            <span class="punta-stub-barcode" aria-hidden="true"></span>
                          </div>
                        </div>
                        <img class="punta-stamp punta-stamp--light" src="/photos/punta-cana-passport-stamp.webp" alt="" aria-hidden="true" decoding="async" />
                        <img class="punta-stamp punta-stamp--dark" src="/photos/punta-cana-passport-stamp-dark-display.webp" alt="" aria-hidden="true" decoding="async" />
                        </div>
                    </div>
                  </div>
                </div>
              ) : (
                <TripCollage trip={trip} />
              )}
            </div>
          </article>
        ))}
        <div class="travel-timeline-end" aria-hidden="true">
          <span class="travel-timeline-marker"></span>
          <span class="font-serif text-sm italic text-main/45">and then, wherever next</span>
        </div>
      </div>
    </div>

  </section>

  <section class="mb-16 grid gap-8 border-t border-main/25 pt-8 sm:mb-24 sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-12 sm:pt-10" aria-labelledby="places-heading">
    <div>
      <span class="mb-3 block text-[0.65rem] font-medium uppercase tracking-[0.18em] text-main/45">The index</span>
      <h2 id="places-heading" class="font-serif text-2xl italic sm:text-3xl">Places so far</h2>
      <p class="mt-3 text-sm leading-relaxed text-main/55">
        {travelData.countries.length} countries, {statesCount} states, and Washington, DC.
      </p>
    </div>
    <div>
      <h3 class="mb-3 text-xs font-medium uppercase tracking-[0.16em] text-main/50">Countries</h3>
      <ul class="grid gap-x-7 sm:grid-cols-2">
        {travelData.countries.map((country) => (
          <li class="border-t border-main/15 py-3">
            <span class="block font-serif text-lg leading-tight">{country.name}</span>
            <span class="mt-1 block text-xs leading-relaxed text-main/50">{country.notes ?? country.visitedDate}</span>
          </li>
        ))}
      </ul>
      <details class="group mt-5 border-y border-main/20">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 [&::-webkit-details-marker]:hidden">
          <span class="font-serif italic">U.S. states & DC</span>
          <span class="text-lg leading-none text-main/50 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <ul class="grid gap-x-6 gap-y-2 pb-6 text-sm text-main/70 sm:grid-cols-3">
          {travelData.states.map((state) => <li>{state.name}</li>)}
        </ul>
      </details>
    </div>
  </section>

  <section class="mb-16 sm:mb-24" aria-label="Full route log">
    <details class="group border-y border-main/20">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 [&::-webkit-details-marker]:hidden">
        <h2 class="font-serif text-lg italic">Full route log</h2>
        <span class="flex items-center gap-5 text-xs text-main/50">
          {travelData.journeys.length} air and sea legs
          <span class="text-lg leading-none transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
        </span>
      </summary>
      <div class="pb-8">
        {journeyGroups.map(([year, journeys]) => (
          <div class="grid gap-2 border-t border-main/15 py-5 sm:grid-cols-[6rem_minmax(0,1fr)] sm:gap-6">
            <h3 class="font-serif text-lg italic text-main/55">{year}</h3>
            <ol>
              {journeys.map((journey) => (
                <li class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 border-b border-main/10 py-2 text-sm last:border-b-0">
                  <span>{journey.from} <span class="mx-1 text-main/35">→</span> {journey.to}</span>
                  <span class="font-serif text-xs italic text-main/45">{journey.mode === 'air' ? 'air' : 'sea'}</span>
                </li>
              ))}
            </ol>
          </div>
        ))}
        <p class="text-xs leading-relaxed text-main/50">Road trips aren’t included in this log.</p>
      </div>
    </details>
  </section>

  <section class="bg-muted px-6 py-8 sm:px-10 sm:py-10" aria-labelledby="future-heading">
    <div class="flex items-start justify-between gap-5">
      <div>
        <span class="mb-3 block text-[0.65rem] font-medium uppercase tracking-[0.18em] text-main/45">The long game</span>
        <h2 id="future-heading" class="font-serif text-2xl italic sm:text-3xl">Still on my mind</h2>
      </div>
      <span class="font-serif text-3xl italic text-main/25 sm:text-4xl" aria-hidden="true">↗</span>
    </div>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-main/60 sm:text-base">
      I’d like to make it to all seven continents eventually. For now, these are simply places I hope to see.
    </p>
    <ul class="mt-8 grid gap-x-8 sm:grid-cols-2">
      {placesOnMyMind.map((place) => (
        <li class="border-t border-main/20 py-3 font-serif text-xl sm:text-2xl">{place}</li>
      ))}
    </ul>
    <details class="group mt-4 border-t border-main/20">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 pt-5 text-sm [&::-webkit-details-marker]:hidden">
        <span class="font-serif italic">And {otherFuturePlaces.length} more places</span>
        <span class="text-lg leading-none text-main/50 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
      <ul class="grid gap-x-6 gap-y-2 pt-6 text-sm leading-relaxed text-main/70 sm:grid-cols-2">
        {otherFuturePlaces.map((place) => <li>{place}</li>)}
      </ul>
    </details>
  </section>
</BaseLayout>

<script>
  const initTravelTimeline = () => {
    const timeline = document.querySelector('[data-travel-timeline]');
    if (!(timeline instanceof HTMLElement) || timeline.dataset.ready === 'true') return;

    const entries = Array.from(timeline.querySelectorAll('[data-timeline-entry]'));
    const firstMarker = entries[0]?.querySelector('.travel-timeline-marker');
    const date = timeline.querySelector('[data-timeline-date]');
    const count = timeline.querySelector('[data-timeline-count]');
    const lineProgress = timeline.querySelector('[data-timeline-line-progress]');
    const endMarker = timeline.querySelector('.travel-timeline-end .travel-timeline-marker');
    const puntaScenes = Array.from(timeline.querySelectorAll('[data-punta-scene]'));
    if (!(firstMarker instanceof HTMLElement) || !(date instanceof HTMLElement) || !(count instanceof HTMLElement) ||
        !(lineProgress instanceof HTMLElement) || !(endMarker instanceof HTMLElement)) return;

    timeline.dataset.ready = 'true';
    let activeEntry = null;
    let dateCueEntry = null;
    let dateCueScrollY = 0;
    let dateCueVisible = false;
    let holdFirstDateOnUpwardScroll = false;
    let lastScrollY = window.scrollY;
    let scrollDirection = 0;

    const setActive = (entry) => {
      if (entry !== activeEntry) {
        entries.forEach((item) => item.classList.toggle('is-active', item === entry));
        activeEntry = entry;
        if (dateCueEntry instanceof HTMLElement) dateCueEntry.classList.remove('is-date-visible');
        entry.classList.add('is-date-visible');
        dateCueEntry = entry;
        dateCueScrollY = window.scrollY;
        dateCueVisible = true;
        holdFirstDateOnUpwardScroll = entry === entries[0];
        const index = entries.indexOf(entry) + 1;
        date.textContent = entry.dataset.timelineDate ?? '';
        count.textContent = `Trip ${String(index).padStart(2, '0')} / ${String(entries.length).padStart(2, '0')}`;
      }
    };

    const updateTimelineProgress = () => {
      const firstRect = firstMarker.getBoundingClientRect();
      const playhead = firstRect.top + firstRect.height / 2 + Math.max(0, window.scrollY);
      const lineTop = lineProgress.getBoundingClientRect().top;
      const endRect = endMarker.getBoundingClientRect();
      const lineEnd = endRect.bottom - lineTop;

      let currentEntry = entries[0];
      const markerStates = entries.map((entry, index) => {
        const marker = entry.querySelector('.travel-timeline-marker');
        if (!(marker instanceof HTMLElement)) return { entry, reached: false };
        const markerRect = marker.getBoundingClientRect();
        const reached = index === 0 || markerRect.top + markerRect.height / 2 <= playhead;
        if (reached) currentEntry = entry;
        return { entry, reached };
      });

      lineProgress.style.height = `${Math.max(0, Math.min(playhead + firstRect.height / 2 - lineTop, lineEnd))}px`;
      markerStates.forEach(({ entry, reached }) => entry.classList.toggle('is-reached', reached));
      endMarker.classList.toggle('is-reached', endRect.top + endRect.height / 2 <= playhead);
      if (currentEntry instanceof HTMLElement) setActive(currentEntry);
      if (dateCueEntry instanceof HTMLElement) {
        if (dateCueEntry === entries[0] && scrollDirection < 0) {
          holdFirstDateOnUpwardScroll = true;
        }
        if (holdFirstDateOnUpwardScroll && scrollDirection > 0) {
          holdFirstDateOnUpwardScroll = false;
          dateCueScrollY = window.scrollY;
        }
        const cueShouldBeVisible = holdFirstDateOnUpwardScroll || Math.abs(window.scrollY - dateCueScrollY) < 96;
        if (cueShouldBeVisible !== dateCueVisible) {
          dateCueEntry.classList.toggle('is-date-visible', cueShouldBeVisible);
          dateCueVisible = cueShouldBeVisible;
        }
      }
    };

    let scrollFrame = 0;
    const updateScrollEffects = () => {
      scrollFrame = 0;
      const viewportHeight = window.innerHeight;
      const currentScrollY = window.scrollY;
      scrollDirection = currentScrollY < lastScrollY ? -1 : currentScrollY > lastScrollY ? 1 : 0;
      lastScrollY = currentScrollY;
      updateTimelineProgress();

      const clamp = (value) => Math.min(1, Math.max(0, value));
      const between = (value, start, end) => clamp((value - start) / (end - start));
      const settle = (value) => 1 - Math.pow(1 - value, 3);

      puntaScenes.forEach((scene) => {
        if (!(scene instanceof HTMLElement)) return;
        const rect = scene.getBoundingClientRect();
        const sceneProgress = clamp(
          (viewportHeight * 0.52 - rect.top) / Math.max(rect.height * 0.78, viewportHeight * 0.38)
        );
        const ticket = 1;
        const stamp = settle(between(sceneProgress, 0.7, 0.9));
        const photoProgress = 1;
        const tearProgress = settle(between(sceneProgress, 0.12, 0.44));
        const release = settle(between(sceneProgress, 0.4, 0.66));
        const flightPhoto = scene.querySelector('.punta-flight-photo');
        const passport = scene.querySelector('.punta-passport');
        const anchorStub = scene.querySelector('.punta-ticket-stub--anchor');
        const tornStub = scene.querySelector('.punta-ticket-stub--torn');
        const anchorSurface = anchorStub?.querySelector('.punta-ticket-stub-surface');
        const tornSurface = tornStub?.querySelector('.punta-ticket-stub-surface');
        const objects = scene.querySelector('.punta-scene-objects');
        const ticketElement = scene.querySelector('.punta-ticket');
        const ticketScale = window.innerWidth >= 651 && objects instanceof HTMLElement && ticketElement instanceof HTMLElement
          ? Math.max(1, (objects.clientWidth - 16) / ticketElement.offsetWidth)
          : 1;

        scene.style.setProperty('--punta-ticket-y', `${Math.round((1 - ticket) * 112)}px`);
        scene.style.setProperty('--punta-ticket-rotate', `${(5.5 - ticket * 6.7).toFixed(2)}deg`);
        scene.style.setProperty('--punta-ticket-scale', ticketScale.toFixed(3));
        scene.style.setProperty('--punta-ticket-height', `${Math.round((ticketElement instanceof HTMLElement ? ticketElement.offsetHeight : 160) * ticketScale)}px`);
        scene.style.setProperty('--punta-ticket-opacity', ticket.toFixed(3));
        scene.style.setProperty('--punta-stamp-x', `${Math.round((1 - stamp) * 18)}px`);
        scene.style.setProperty('--punta-stamp-y', `${Math.round((1 - stamp) * -28)}px`);
        scene.style.setProperty('--punta-stamp-scale', `${(1 + (1 - stamp) * 0.55 + Math.sin(stamp * Math.PI * 2) * 0.15).toFixed(3)}`);
        scene.style.setProperty('--punta-stamp-rotate', `${(18 - stamp * 27).toFixed(2)}deg`);
        scene.style.setProperty('--punta-stamp-opacity', stamp.toFixed(3));
        scene.style.setProperty('--punta-photo-progress', photoProgress.toFixed(3));
        if (flightPhoto instanceof HTMLElement) {
          const photoX = -4 + photoProgress * 5;
          const photoY = 34 - photoProgress * 34;
          const photoRotate = -6 + photoProgress * 3;
          const photoScale = 0.86 + photoProgress * 0.14;
          flightPhoto.style.opacity = photoProgress.toFixed(3);
          flightPhoto.style.transform = `translate3d(${photoX.toFixed(1)}px, ${photoY.toFixed(1)}px, 0) rotate(${photoRotate.toFixed(2)}deg) scale(${photoScale.toFixed(3)})`;
        }
        if (passport instanceof HTMLElement) {
          const passportX = 13 - photoProgress * 13;
          const passportY = -8 + photoProgress * 8;
          const passportRotate = 12 - photoProgress * 4;
          passport.style.opacity = photoProgress.toFixed(3);
          passport.style.transform = `translate3d(${passportX.toFixed(1)}px, ${passportY.toFixed(1)}px, 0) rotate(${passportRotate.toFixed(2)}deg)`;
        }
        const tornTravelX = window.innerWidth <= 359 ? 16 : window.innerWidth <= 639 ? 22 : 30;
        scene.style.setProperty('--punta-torn-x', `${Math.round(release * tornTravelX)}px`);
        scene.style.setProperty('--punta-torn-y', `${Math.round(release * 12)}px`);
        scene.style.setProperty('--punta-torn-rotate', `${(release * 5.8).toFixed(2)}deg`);
        scene.style.setProperty('--punta-anchor-shadow-opacity', (1 - tearProgress).toFixed(3));
        scene.style.setProperty('--punta-torn-shadow-opacity', tearProgress.toFixed(3));

        if (anchorSurface instanceof HTMLElement) {
          anchorSurface.style.clipPath = tearProgress > 0 ? `inset(${(tearProgress * 100).toFixed(2)}% 0 0 0)` : '';
        }
        if (tornSurface instanceof HTMLElement) {
          tornSurface.style.clipPath = tearProgress > 0
            ? `inset(0 0 ${(100 - tearProgress * 100).toFixed(2)}% 0)`
            : 'inset(0 0 100% 0)';
        }
      });
    };

    const onScroll = () => {
      if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateScrollEffects);
    };

    setActive(entries[0]);
    updateScrollEffects();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    }, { once: true });
  };

  initTravelTimeline();
  document.addEventListener('astro:page-load', initTravelTimeline);
</script>

